# Install with: crontab ops/macro-loader.cron
# All schedules use Europe/Vienna wall-clock time, including DST changes.
# The daily runner owns ingestion and PostgreSQL sync; Sunday copies Gold to NAS.

CRON_TZ=Europe/Vienna

# Daily delta refresh at 09:00: publish local Gold, then synchronize PostgreSQL.
0 9 * * * /home/dev_macro/macro-loader/ops/run-macro-loader-daily.sh

# Sunday 22:00: copy Gold to the Quotes NAS destination.
0 22 * * 0 /home/dev_macro/macro-loader/ops/copy-macro-loader-gold.sh
