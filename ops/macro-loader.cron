# Install with: crontab ops/macro-loader.cron
# Daily 10:00 follows Europe/Vienna wall-clock time, including DST changes.
# The single runner owns Fed policy, daily execution, and PostgreSQL synchronization.

CRON_TZ=Europe/Vienna

# Daily at 10:00: update Fed policy, publish local Gold, then synchronize PostgreSQL.
0 10 * * * /home/dev_market/macro-loader/ops/run-macro-loader-sunday.sh
