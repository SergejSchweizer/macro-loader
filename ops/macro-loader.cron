# Install with: crontab ops/macro-loader.cron
# Daily 09:00 follows Europe/Vienna wall-clock time, including DST changes.
# The runner owns configuration export, logging, daily execution, and PostgreSQL sync.

CRON_TZ=Europe/Vienna

# Daily delta refresh at 09:00: publish local Gold, then synchronize PostgreSQL.
0 9 * * * /home/dev_macro/macro-loader/ops/run-macro-loader-daily.sh
